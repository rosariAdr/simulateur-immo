{
  "name": "simulateur-immo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typegen && tsc --noEmit",
    "fixtures": "node scripts/run.mjs scripts/export-fixtures.mts && node scripts/run.mjs scripts/export-design-sheet.mts",
    "design-pack": "node scripts/build-design-pack.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "porte": "npm run typecheck && npm run lint && npm run test && npm run build && npm run e2e",
    "typegen": "next typegen"
  },
  "dependencies": {
    "next": "16.3.1",
    "nuqs": "^2.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "fast-check": "^4.9.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
